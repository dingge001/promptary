# 放到 /etc/nginx/conf.d/promptary-api.conf,把域名和证书路径换成你自己的。
#
# 前提:域名已经备案、证书已经申请。阿里云可以申免费的 DV 证书,
# 也可以用 certbot 走 Let's Encrypt。

server {
    listen 80;
    server_name api.example.com;
    # 备案完成后仍然建议强制跳 HTTPS:请求体里带图片,明文传输说不过去
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    # nginx 1.25.1 之前要写成 `listen 443 ssl http2;`
    http2 on;
    server_name api.example.com;

    ssl_certificate     /etc/nginx/ssl/api.example.com.pem;
    ssl_certificate_key /etc/nginx/ssl/api.example.com.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # base64 图片可能到几百 KB,默认 1M 偶尔会不够
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8787;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        # 服务端靠这个头做速率限制,且它只在「只监听本机」时可信
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # 反推要等视觉模型返回,默认 60s 会把慢请求截断成 504
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
