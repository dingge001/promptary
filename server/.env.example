# 复制成 .env 后填写。.env 不要提交。

# ---------- 上游模型服务 ----------
UPSTREAM_BASE_URL=https://api.deepseek.com
# 你的 DeepSeek API Key。这个 Key 只存在于服务端,绝不能进扩展包
UPSTREAM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UPSTREAM_MODEL=deepseek-flash

# ---------- 额度 ----------
# 单个设备每天可用次数。3 次够让新用户体会到「不同模型写法不同」这个价值点,
# 又不至于被人重装扩展反复薅
DAILY_DEVICE_LIMIT=3
# 全局每天总调用上限。触顶即整体停服 —— 这是防破产的最后一道闸,按自己的预算定
DAILY_GLOBAL_BUDGET=5000
# 强制的输出上限。反推结果是一小段 JSON,512 足够;调大等于把单次成本抬高
MAX_OUTPUT_TOKENS=512

# ---------- 服务 ----------
# 改之前先确认端口没被占用:ss -tln | grep :8788
# (踩过一次:8787 被同机器上的另一个服务占了,服务会以 EADDRINUSE 反复重启)
PORT=8788
# 只听本机,由 Nginx 反代。改成 0.0.0.0 会让 X-Forwarded-For 变成可伪造,慎改
HOST=127.0.0.1
DB_PATH=./data/quota.db
UPSTREAM_TIMEOUT_MS=60000
MAX_BODY_BYTES=4194304
