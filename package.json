{
  "name": "promptary",
  "description": "Reverse-engineer any web image into a ready-to-use AI art prompt. Local-first Chrome extension, bring your own API key.",
  "keywords": [
    "chrome-extension",
    "ai-art",
    "prompt-engineering",
    "image-to-prompt",
    "reverse-engineer-prompt",
    "stable-diffusion",
    "midjourney",
    "flux",
    "seedream",
    "gpt-image",
    "prompt-manager",
    "manifest-v3",
    "local-first"
  ],
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
